# ========================================================
# F.R.I.D.A.Y. - ENVIRONMENT CONFIGURATION
# ========================================================

# WhatsApp Multi-Device Identities (E.164 country code without leading '+')
# AUTHORIZED_USER_PHONE: Your personal mobile number
AUTHORIZED_USER_PHONE=34600000000
# BOT_PHONE: The SIM card / phone number allocated to the bot
BOT_PHONE=34700000000
# AUTHORIZED_USER_LID: WhatsApp LID (automatically detected and logged on first message)
AUTHORIZED_USER_LID=123456789012345

# --------------------------------------------------------
# LLM Provider Configuration
# Supported providers: 'ollama' | 'openai' | 'groq' | 'openrouter' | 'deepseek'
# If any Cloud API key is defined and LLM_PROVIDER is unset, cloud mode is auto-selected.
# --------------------------------------------------------
LLM_PROVIDER=ollama

# Option A: Local Ollama (Default self-hosted)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=jarvis

# Option B: Cloud OpenAI-Compatible APIs (OpenAI, Groq, OpenRouter, DeepSeek, Together, vLLM)
# Standard API Key (e.g. sk-..., gsk_..., sk-or-...)
OPENAI_API_KEY=
# Custom Base URL (leave blank for https://api.openai.com/v1)
# Examples:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com
OPENAI_BASE_URL=
# Model name (e.g. gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, deepseek-chat)
OPENAI_MODEL=

# Dedicated Provider Keys (auto-detected if set):
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-v1-...
# DEEPSEEK_API_KEY=...

# REST API Server Port
PORT=3000

# REST API Authentication (REQUIRED: the API refuses all requests without it)
# Use a long random token, e.g. from "openssl rand -hex 32"
API_TOKEN=

# GitHub Actions Webhook HMAC secret (REQUIRED for /api/webhook/github)
GITHUB_WEBHOOK_SECRET=

# Passphrase for encrypted backups only (AES-256-GCM with scrypt).
# Required by trigger_encrypted_backup; it does NOT encrypt Second Brain data.
BACKUP_PASSPHRASE=

# Dedicated key for Second Brain credential encryption (categoria "clave").
# Without it, saving credentials is refused instead of writing them in plain
# text. It does NOT enable or affect backups.
MEMORY_ENCRYPTION_KEY=

# Network & Host Monitoring (Minecraft / TCP watchdog)
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565

# Default Geolocation (Used by Weather Radar & 07:00 AM Daily Briefing)
DEFAULT_CITY=Madrid
DEFAULT_LAT=40.4168
DEFAULT_LON=-3.7038

# Ticket photo reader (nº 24): local vision model, started per photo and
# unloaded after each read (keep_alive 0). Without DAVIS_TICKET_VISION_MODEL
# the reader stays off and the bot offers the text path.
# Boot contract: these vars are read from DAVIS_ENV_FILE, <DATA_DIR>/.env or
# <repo>/.env, whichever defines them first; a plain restart picks up NEW
# vars, but a var already cached by pm2 needs `pm2 restart --update-env`.
DAVIS_TICKET_VISION_MODEL=
DAVIS_TICKET_VISION_PROVIDER=
DAVIS_TICKET_VISION_BASE_URL=
DAVIS_TICKET_VISION_TIMEOUT_MS=180000
# Explicit env file path, if the deployment keeps it elsewhere.
DAVIS_ENV_FILE=

# Persistencia transaccional (mejora 2): json (por defecto) o sqlite.
# Con sqlite hace falta `npm ci` (better-sqlite3 nativo) y la base vive
# por defecto en DATA_DIR/jarvis.db. Ver docs/persistencia-sqlite.md.
# DAVIS_PERSISTENCE=json
# DAVIS_SQLITE_PATH=/home/ubuntu/jarvis-estado/data/jarvis.db
